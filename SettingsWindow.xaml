<Window x:Class="HyperNotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni HyperNotch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="620"
        Height="430"
        ResizeMode="NoResize"
        UseLayoutRounding="False"
        SnapsToDevicePixels="False"
        FontFamily="pack://application:,,,/Assets/Fonts/#Inter, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        RenderOptions.BitmapScalingMode="Fant"
        RenderOptions.EdgeMode="Unspecified"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="SettingsSidebarBgBrush" Color="#0F0F15"/>
        <SolidColorBrush x:Key="SettingsSidebarBorderBrush" Color="#1E1E28"/>
        <SolidColorBrush x:Key="SettingsCardBgBrush" Color="#13131A"/>
        <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#22222C"/>
        <SolidColorBrush x:Key="SettingsNavHoverBrush" Color="#181822"/>
        <SolidColorBrush x:Key="SettingsNavActiveBrush" Color="#1D283A"/>
        <SolidColorBrush x:Key="SettingsTrackBgBrush" Color="#1D1D26"/>
        <SolidColorBrush x:Key="SettingsSecondaryTextBrush" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="SettingsAccentBrush" Color="#38BDF8"/>

        <Style x:Key="NavBtnStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SettingsSecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SettingsNavHoverBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SettingsNavActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SettingsAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border x:Name="Track" Grid.Column="1" Width="42" Height="22" CornerRadius="11" Background="#272732" Padding="2">
                                <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9" Background="#FFFFFF" HorizontalAlignment="Left"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0EA5E9"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSettingsSlider" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="20">
                            <Border Height="6" Background="{DynamicResource SettingsTrackBgBrush}" CornerRadius="3" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="#0EA5E9" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="16"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="15" Height="15">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FFFFFF" BorderBrush="#38BDF8" BorderThickness="2.5" CornerRadius="7.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="Background" Value="#16161F"/>
            <Setter Property="BorderBrush" Value="#2A2A36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="12,8">
                                            <Grid>
                                                <ContentPresenter/>
                                                <TextBlock Text="▾" Foreground="#8E8E98" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#171721" BorderBrush="#2E2E3C" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}" Padding="4">
                                    <ScrollViewer MaxHeight="180"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252534"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeCardStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#14141C" BorderBrush="#262632" BorderThickness="1.5" CornerRadius="12" Padding="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="Bd" Property="Background" Value="#162232"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeybindBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SettingsCardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SettingsNavActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SettingsCardBgBrush}"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="SettingsRootBorder" Background="#0A0A0E" BorderBrush="#282834" BorderThickness="1.5" CornerRadius="20" Margin="6" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SettingsBannerLayer" Grid.ColumnSpan="2" CornerRadius="19" IsHitTestVisible="False" Visibility="Collapsed">
                <Border CornerRadius="19">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#44000000" Offset="0.0"/>
                            <GradientStop Color="#AA000000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>

            <Border x:Name="SettingsGlossOverlay" Grid.ColumnSpan="2" CornerRadius="20" IsHitTestVisible="False" Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#45FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#14FFFFFF" Offset="0.45"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- LEFT SIDEBAR -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource SettingsSidebarBgBrush}" BorderBrush="{DynamicResource SettingsSidebarBorderBrush}" BorderThickness="0,0,1,0" CornerRadius="19,0,0,19" Padding="14,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="4,0,0,20" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Border Width="12" Height="12" CornerRadius="6" Background="#38BDF8" Margin="0,0,9,0"/>
                        <TextBlock Text="HyperNotch" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavScreen" Content="🖥  Schermo" Style="{StaticResource NavBtnStyle}" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavThemes" Content="🎨  Temi" Style="{StaticResource NavBtnStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavCustom" Content="🖼  Sfondo" Style="{StaticResource NavBtnStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavCommunity" Content="🌐  Community" Style="{StaticResource NavBtnStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSystem" Content="⚙  Sistema" Style="{StaticResource NavBtnStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavInfo" Content="ℹ  Info" Style="{StaticResource NavBtnStyle}" Checked="Nav_Checked"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Windows 10/11 • .NET 8" FontSize="10.5" Foreground="#52525B" Margin="6,0,0,0"/>
                </Grid>
            </Border>

            <!-- RIGHT CONTENT -->
            <Grid Grid.Column="1" Margin="20,16,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,14">
                    <TextBlock x:Name="PageTitleText" Text="Posizione e Monitor" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Button Width="28" Height="28" Padding="0" HorizontalAlignment="Right" Style="{StaticResource ActionBtn}" Background="#171720" Click="Close_Click">
                        <Path Width="11" Height="11" Stretch="Uniform" Stroke="#E4E4E7" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,4 L20,20 M20,4 L4,20"/>
                    </Button>
                </Grid>

                <!-- Page 0: Screen & Position -->
                <StackPanel x:Name="PageScreen" Grid.Row="1" Visibility="Visible">
                    <TextBlock x:Name="MonitorLabel" Text="Monitor di visualizzazione" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                    <ComboBox x:Name="MonitorCombo" SelectionChanged="SettingsChanged" Margin="0,0,0,18"/>

                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="OffsetXTitleLabel" Text="Offset Orizzontale (X)" FontSize="12" Foreground="#D4D4D8"/>
                        <TextBlock x:Name="OffsetXLabel" Text="0 px" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="OffsetXSlider" Minimum="-1000" Maximum="1000" Style="{StaticResource ModernSettingsSlider}" ValueChanged="OffsetSlider_ValueChanged" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="OffsetYTitleLabel" Text="Offset Verticale (Y)" FontSize="12" Foreground="#D4D4D8"/>
                        <TextBlock x:Name="OffsetYLabel" Text="10 px" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="OffsetYSlider" Minimum="0" Maximum="300" Style="{StaticResource ModernSettingsSlider}" ValueChanged="OffsetSlider_ValueChanged"/>

                    <Border Background="{DynamicResource SettingsCardBgBrush}" BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                        <CheckBox x:Name="NotchModeCheck" Content="Stile Notch MacBook Air (attaccata allo schermo)" Style="{StaticResource ModernSwitch}" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                    </Border>
                </StackPanel>

                <!-- Page 1: Visual Theme Cards -->
                <UniformGrid x:Name="PageThemes" Grid.Row="1" Columns="2" Rows="2" Visibility="Collapsed">
                    <RadioButton x:Name="ThemeOledBtn" GroupName="Themes" Style="{StaticResource ThemeCardStyle}" Margin="0,0,6,6" Checked="ThemeCard_Checked">
                        <StackPanel VerticalAlignment="Center">
                            <Border Height="22" Width="76" CornerRadius="11" Background="#050507" BorderBrush="#27272A" BorderThickness="1.5" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ThemeOledTitle" Text="Nero OLED" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="ThemeOledSub" Text="Contrasto puro #050507" Foreground="#8E8E98" FontSize="11"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ThemeAcrylicBtn" GroupName="Themes" Style="{StaticResource ThemeCardStyle}" Margin="6,0,0,6" Checked="ThemeCard_Checked">
                        <StackPanel VerticalAlignment="Center">
                            <Border Height="22" Width="76" CornerRadius="11" Background="#CC1F2430" BorderBrush="#60FFFFFF" BorderThickness="1.5" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ThemeAcrylicTitle" Text="Vetro Smerigliato" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="ThemeAcrylicSub" Text="Traslucido stile Win11" Foreground="#8E8E98" FontSize="11"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ThemeAeroBtn" GroupName="Themes" Style="{StaticResource ThemeCardStyle}" Margin="0,6,6,0" Checked="ThemeCard_Checked">
                        <StackPanel VerticalAlignment="Center">
                            <Border Height="22" Width="76" CornerRadius="11" BorderBrush="#B0FFFFFF" BorderThickness="1.5" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#0284C7" Offset="0"/>
                                        <GradientStop Color="#0D9488" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock x:Name="ThemeAeroTitle" Text="Frutiger Aero" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="ThemeAeroSub" Text="Lucido azzurro/acqua" Foreground="#8E8E98" FontSize="11"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ThemeRgbBtn" GroupName="Themes" Style="{StaticResource ThemeCardStyle}" Margin="6,6,0,0" Checked="ThemeCard_Checked">
                        <StackPanel VerticalAlignment="Center">
                            <Border Height="22" Width="76" CornerRadius="11" Background="#09090C" BorderThickness="2" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Cyan" Offset="0"/>
                                        <GradientStop Color="Magenta" Offset="0.5"/>
                                        <GradientStop Color="Lime" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <TextBlock x:Name="ThemeRgbTitle" Text="Bordo RGB" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="ThemeRgbSub" Text="Arcobaleno animato" Foreground="#8E8E98" FontSize="11"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>

                <!-- Page 2: Solid Colors, Presets & Custom Hex -->
                <ScrollViewer x:Name="PageCustom" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <TextBlock x:Name="PickBarColorLabel" Text="Scegli un colore per la barra" FontSize="11.5" Foreground="{DynamicResource SettingsSecondaryTextBrush}" Margin="0,0,0,8"/>
                        <UniformGrid Columns="4" Margin="0,0,0,12">
                            <Button x:Name="ColorRedBtn" Content="Rosso" Style="{StaticResource ActionBtn}" Background="#B91C1C" BorderBrush="#FCA5A5" Padding="6,7" FontSize="11" Margin="0,0,6,6" Tag="#B91C1C|#FCA5A5|#FDE047" Click="PresetColor_Click"/>
                            <Button x:Name="ColorOrangeBtn" Content="Arancione" Style="{StaticResource ActionBtn}" Background="#C2410C" BorderBrush="#FDBA74" Padding="6,7" FontSize="11" Margin="0,0,6,6" Tag="#C2410C|#FDBA74|#FED7AA" Click="PresetColor_Click"/>
                            <Button x:Name="ColorYellowBtn" Content="Giallo" Style="{StaticResource ActionBtn}" Background="#A16207" BorderBrush="#FDE047" Padding="6,7" FontSize="11" Margin="0,0,6,6" Tag="#A16207|#FDE047|#FEF08A" Click="PresetColor_Click"/>
                            <Button x:Name="ColorGreenBtn" Content="Verde" Style="{StaticResource ActionBtn}" Background="#15803D" BorderBrush="#86EFAC" Padding="6,7" FontSize="11" Margin="0,0,0,6" Tag="#15803D|#86EFAC|#BBF7D0" Click="PresetColor_Click"/>

                            <Button x:Name="ColorEmeraldBtn" Content="Smeraldo" Style="{StaticResource ActionBtn}" Background="#047857" BorderBrush="#6EE7B7" Padding="6,7" FontSize="11" Margin="0,0,6,6" Tag="#047857|#6EE7B7|#34D399" Click="PresetColor_Click"/>
                            <Button x:Name="ColorCyanBtn" Content="Ciano" Style="{StaticResource ActionBtn}" Background="#0E7490" BorderBrush="#67E8F9" Padding="6,7" FontSize="11" Margin="0,0,6,6" Tag="#0E7490|#67E8F9|#22D3EE" Click="PresetColor_Click"/>
                            <Button x:Name="ColorBlueBtn" Content="Blu" Style="{StaticResource ActionBtn}" Background="#1D4ED8" BorderBrush="#93C5FD" Padding="6,7" FontSize="11" Margin="0,0,6,6" Tag="#1D4ED8|#93C5FD|#38BDF8" Click="PresetColor_Click"/>
                            <Button x:Name="ColorIndigoBtn" Content="Indaco" Style="{StaticResource ActionBtn}" Background="#4338CA" BorderBrush="#A5B4FC" Padding="6,7" FontSize="11" Margin="0,0,0,6" Tag="#4338CA|#A5B4FC|#C7D2FE" Click="PresetColor_Click"/>

                            <Button x:Name="ColorPurpleBtn" Content="Viola" Style="{StaticResource ActionBtn}" Background="#7E22CE" BorderBrush="#D8B4FE" Padding="6,7" FontSize="11" Margin="0,0,6,0" Tag="#7E22CE|#D8B4FE|#F0ABFC" Click="PresetColor_Click"/>
                            <Button x:Name="ColorPinkBtn" Content="Rosa" Style="{StaticResource ActionBtn}" Background="#BE185D" BorderBrush="#F9A8D4" Padding="6,7" FontSize="11" Margin="0,0,6,0" Tag="#BE185D|#F9A8D4|#FBCFE8" Click="PresetColor_Click"/>
                            <Button x:Name="ColorSilverBtn" Content="Argento" Style="{StaticResource ActionBtn}" Background="#475569" BorderBrush="#CBD5E1" Padding="6,7" FontSize="11" Margin="0,0,6,0" Tag="#475569|#CBD5E1|#F8FAFC" Click="PresetColor_Click"/>
                            <Button x:Name="ColorBlackBtn" Content="Nero" Style="{StaticResource ActionBtn}" Background="#111827" BorderBrush="#4B5563" Padding="6,7" FontSize="11" Tag="#111827|#4B5563|#F9FAFB" Click="PresetColor_Click"/>
                        </UniformGrid>

                        <TextBlock x:Name="PresetBgLabel" Text="Sfondi predefiniti" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SettingsSecondaryTextBrush}" Margin="0,0,0,6"/>
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Button x:Name="PreCyberBtn" Content="Cyberpunk Neon" Style="{StaticResource ActionBtn}" Background="#1A0B2E" BorderBrush="#F43F5E" Padding="6,7" FontSize="10.5" Margin="0,0,6,6" Tag="#1A0B2E|#F43F5E|#22D3EE" Click="PresetColor_Click"/>
                            <Button x:Name="PreSynthBtn" Content="Tramonto Synth" Style="{StaticResource ActionBtn}" Background="#3B0764" BorderBrush="#FB7185" Padding="6,7" FontSize="10.5" Margin="0,0,6,6" Tag="#3B0764|#FB7185|#FDE047" Click="PresetColor_Click"/>
                            <Button x:Name="PreNordicBtn" Content="Foresta Nordica" Style="{StaticResource ActionBtn}" Background="#064E3B" BorderBrush="#34D399" Padding="6,7" FontSize="10.5" Margin="0,0,0,6" Tag="#064E3B|#34D399|#A7F3D0" Click="PresetColor_Click"/>
                            <Button x:Name="PreOceanBtn" Content="Oceano Profondo" Style="{StaticResource ActionBtn}" Background="#0C4A6E" BorderBrush="#38BDF8" Padding="6,7" FontSize="10.5" Margin="0,0,6,0" Tag="#0C4A6E|#38BDF8|#7DD3FC" Click="PresetColor_Click"/>
                            <Button x:Name="PreLavaBtn" Content="Fuoco Lavico" Style="{StaticResource ActionBtn}" Background="#7F1D1D" BorderBrush="#FB923C" Padding="6,7" FontSize="10.5" Margin="0,0,6,0" Tag="#7F1D1D|#FB923C|#FBBF24" Click="PresetColor_Click"/>
                            <Button x:Name="PreIceBtn" Content="Minimal Ghiaccio" Style="{StaticResource ActionBtn}" Background="#1E293B" BorderBrush="#CBD5E1" Padding="6,7" FontSize="10.5" Tag="#1E293B|#CBD5E1|#E2E8F0" Click="PresetColor_Click"/>
                        </UniformGrid>

                        <TextBlock x:Name="CustomHexLabel" Text="Codici personalizzati (#RRGGBB)" FontSize="11" Foreground="{DynamicResource SettingsSecondaryTextBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="HexBgLabel" Text="Sfondo" FontSize="10.5" Foreground="{DynamicResource SettingsSecondaryTextBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="CustomBgBox" Style="{StaticResource KeybindBoxStyle}" IsReadOnly="False" Cursor="IBeam" Padding="8,5" TextChanged="CustomColorBox_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="HexBorderLabel" Text="Bordo" FontSize="10.5" Foreground="{DynamicResource SettingsSecondaryTextBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="CustomBorderBox" Style="{StaticResource KeybindBoxStyle}" IsReadOnly="False" Cursor="IBeam" Padding="8,5" TextChanged="CustomColorBox_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock x:Name="HexAccentLabel" Text="Accento" FontSize="10.5" Foreground="{DynamicResource SettingsSecondaryTextBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="CustomAccentBox" Style="{StaticResource KeybindBoxStyle}" IsReadOnly="False" Cursor="IBeam" Padding="8,5" TextChanged="CustomColorBox_TextChanged"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Page 3: Community Backgrounds & Create Background -->
                <Grid x:Name="PageCommunity" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CommunityDescLabel" Grid.Column="0" Text="Esplora sfondi o creane uno salvato sul tuo PC" FontSize="11.5" Foreground="{DynamicResource SettingsSecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                        <Button x:Name="ToggleCreateBgBtn" Grid.Column="1" Content="+ Crea Sfondo" Style="{StaticResource ActionBtn}" Padding="10,6" FontSize="11.5" VerticalAlignment="Center" Click="ToggleCreateBg_Click"/>
                    </Grid>

                    <!-- Inline Create Background Panel -->
                    <Border x:Name="CreateBgPanel" Grid.Row="1" Background="{DynamicResource SettingsCardBgBrush}" BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="NewBgNameLabel" Text="Nome" FontSize="10.5" Foreground="{DynamicResource SettingsSecondaryTextBrush}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="NewBgNameBox" Style="{StaticResource KeybindBoxStyle}" IsReadOnly="False" Cursor="IBeam" Padding="8,5" Text="Mio Sfondo"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="NewBgColorLabel" Text="Sfondo" FontSize="10.5" Foreground="{DynamicResource SettingsSecondaryTextBrush}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="NewBgColorBox" Style="{StaticResource KeybindBoxStyle}" IsReadOnly="False" Cursor="IBeam" Padding="8,5" Text="#1E1B4B"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock x:Name="NewBgBorderLabel" Text="Bordo" FontSize="10.5" Foreground="{DynamicResource SettingsSecondaryTextBrush}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="NewBgBorderBox" Style="{StaticResource KeybindBoxStyle}" IsReadOnly="False" Cursor="IBeam" Padding="8,5" Text="#818CF8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock x:Name="NewBgAccentLabel" Text="Accento" FontSize="10.5" Foreground="{DynamicResource SettingsSecondaryTextBrush}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="NewBgAccentBox" Style="{StaticResource KeybindBoxStyle}" IsReadOnly="False" Cursor="IBeam" Padding="8,5" Text="#38BDF8"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BrowseNewBgImgBtn" Content="📁 Immagine (opz.)" Style="{StaticResource ActionBtn}" Padding="9,5" FontSize="11" Margin="0,0,8,0" Click="BrowseNewBgImage_Click"/>
                                    <TextBlock x:Name="NewBgImageStatus" Text="Nessuna immagine" FontSize="10.5" Foreground="{DynamicResource SettingsSecondaryTextBrush}" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button x:Name="SaveNewBgBtn" Content="💾 Salva sul PC" Style="{StaticResource ActionBtn}" Background="#0284C7" BorderBrush="#38BDF8" Padding="12,5" FontSize="11" HorizontalAlignment="Right" Click="SaveNewBg_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="CommunityListPanel"/>
                    </ScrollViewer>
                </Grid>

                <!-- Page 4: System -->
                <StackPanel x:Name="PageSystem" Grid.Row="1" Visibility="Collapsed">
                    <Border Background="{DynamicResource SettingsCardBgBrush}" BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                        <CheckBox x:Name="AutoGameModeCheck" Content="Game Mode automatico a schermo intero" Style="{StaticResource ModernSwitch}" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                    </Border>
                    <Border Background="{DynamicResource SettingsCardBgBrush}" BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                        <CheckBox x:Name="AutoStartCheck" Content="Avvio automatico con Windows" Style="{StaticResource ModernSwitch}" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                    </Border>
                    <Border Background="{DynamicResource SettingsCardBgBrush}" BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="LanguageLabel" Text="Seleziona la tua lingua" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                            <ComboBox x:Name="LanguageCombo" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectionChanged="SettingsChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Page 5: Info -->
                <StackPanel x:Name="PageInfo" Grid.Row="1" Visibility="Collapsed">
                    <Border Background="{DynamicResource SettingsCardBgBrush}" BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="HyperNotch" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                            <TextBlock x:Name="HyperNotchDescText" Text="HyperNotch porta su Windows 10 e Windows 11 un'isola dinamica ultra-fluida fino a 240fps e ad alta definizione: controlla la musica con equalizzatore live, monitora CPU, RAM, GPU con grafici sparkline, rete e batteria in tempo reale, gestisci timer, azioni rapide, appunti recenti e calcolatrice istantanea da tastiera nella sezione Utilità, con Game Mode automatico, 11 lingue e temi o sfondi personalizzati."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource SettingsSecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- Creator Card matching HyperNotch description card style -->
                    <Border Background="{DynamicResource SettingsCardBgBrush}" BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" Width="46" Height="46" Stroke="#8C6D2E" StrokeThickness="1.6" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="pack://application:,,,/Assets/itsalee_avatar.png" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <TextBlock Text="ItsAlee" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock Text="👑" FontSize="13" Foreground="#F59E0B" VerticalAlignment="Center" Margin="6,0,7,0"/>
                                    <Border Background="#2D220B" BorderBrush="#785E2B" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="CreatorBadgeText" Text="Creator" FontSize="10.5" FontWeight="SemiBold" Foreground="#FBBF24"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="CreatorBioText" Text="Creatore e sviluppatore di HyperNotch. Progetta l'app desktop, l'interfaccia, il monitoraggio di sistema e gli sfondi."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource SettingsSecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="ResetBtn" Content="Ripristina" Style="{StaticResource ActionBtn}" Margin="0,0,10,0" Click="Reset_Click"/>
                    <Button x:Name="SaveBtn" Content="Salva e Chiudi" Style="{StaticResource ActionBtn}" Background="#0284C7" BorderBrush="#38BDF8" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
