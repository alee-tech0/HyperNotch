<Window x:Class="HyperNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HyperNotch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="False"
        SnapsToDevicePixels="False"
        FontFamily="pack://application:,,,/Assets/Fonts/#Inter, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        RenderOptions.BitmapScalingMode="Fant"
        RenderOptions.EdgeMode="Unspecified"
        Width="540"
        Height="250">

    <Window.Resources>
        <!-- Theme-aware Dynamic Brushes (updated in ApplyTheme) -->
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#121218"/>
        <SolidColorBrush x:Key="SurfaceCardBorderBrush" Color="#23232E"/>
        <SolidColorBrush x:Key="TabBarBgBrush" Color="#121217"/>
        <SolidColorBrush x:Key="TabActiveBgBrush" Color="#262632"/>
        <SolidColorBrush x:Key="ButtonBgBrush" Color="#16161D"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#242430"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2A2A35"/>
        <SolidColorBrush x:Key="TrackBgBrush" Color="#1B1B22"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9A9AA4"/>

        <Style x:Key="TabBtnStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabActiveBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleMediaBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{DynamicResource TrackBgBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Track"/>
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                            </Decorator>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" VerticalAlignment="Center" Height="20">
                            <Border Height="5" Background="{DynamicResource TrackBgBrush}" CornerRadius="2.5" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="2.5" Background="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="14"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="13" Height="13">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FFFFFF" BorderBrush="{DynamicResource AccentTextBrush}" BorderThickness="2" CornerRadius="6.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{x:Null}">
        <Grid x:Name="PillHost"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,4,0,0"
              MouseEnter="Island_MouseEnter"
              MouseLeave="Island_MouseLeave"
              MouseLeftButtonDown="Island_MouseLeftButtonDown"
              MouseWheel="Island_MouseWheel">

            <!-- PURE BACKGROUND PILL (Zero children -> 120fps) -->
            <Border x:Name="IslandBorder"
                    Width="256"
                    Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#050507"
                    BorderBrush="#1F1F23"
                    BorderThickness="1.3"
                    CornerRadius="20"
                    ClipToBounds="True">
                <Grid>
                    <Border x:Name="CustomBannerLayer"
                            CornerRadius="19"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <Border CornerRadius="19">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1A000000" Offset="0.0"/>
                                    <GradientStop Color="#99000000" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <Border x:Name="GlossOverlay"
                            VerticalAlignment="Top"
                            Height="18"
                            CornerRadius="18,18,6,6"
                            Margin="2,1,2,0"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#77FFFFFF" Offset="0"/>
                                <GradientStop Color="#0AFFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="ContentClipHost" Width="504" Height="226" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid.Clip>
                    <RectangleGeometry x:Name="PillClipRect" Rect="124,0,256,40" RadiusX="20" RadiusY="20"/>
                </Grid.Clip>

            <!-- 1. COMPACT VIEW -->
            <Grid x:Name="CompactView" Width="256" Height="40" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Visible" Opacity="1">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="MiniArtBorder" Grid.Column="0" Width="22" Height="22" CornerRadius="6" Visibility="Collapsed" Margin="0,0,7,0">
                        <Image x:Name="MiniAlbumArt" Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,22,22" RadiusX="6" RadiusY="6"/>
                            </Image.Clip>
                        </Image>
                    </Border>

                    <TextBlock x:Name="CompactClockText" Grid.Column="1" Text="00:00" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>

                    <TextBlock x:Name="CompactStatusText" Grid.Column="3" Text="CPU 0%" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Height="16">
                        <Border x:Name="EqBar1" Width="2.5" Height="14" CornerRadius="1.2" Background="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.36"/></Border.RenderTransform></Border>
                        <Border x:Name="EqBar2" Width="2.5" Height="14" CornerRadius="1.2" Background="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.78"/></Border.RenderTransform></Border>
                        <Border x:Name="EqBar3" Width="2.5" Height="14" CornerRadius="1.2" Background="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.57"/></Border.RenderTransform></Border>
                        <Border x:Name="EqBar4" Width="2.5" Height="14" CornerRadius="1.2" Background="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.93"/></Border.RenderTransform></Border>
                        <Border x:Name="EqBar5" Width="2.5" Height="14" CornerRadius="1.2" Background="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.43"/></Border.RenderTransform></Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 2. TEMPORARY HUD BANNER VIEW -->
            <Grid x:Name="HudBannerView" Width="368" Height="70" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="HudIconBox" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                        <Grid>
                            <TextBlock x:Name="HudIconText" Text="🔊" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="HudAppIcon" Stretch="UniformToFill" Visibility="Collapsed">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,38,38" RadiusX="11" RadiusY="11"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HudTitleText" Text="Volume" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="HudSubtitleText" Text="" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                        <ProgressBar x:Name="HudProgressBar" Style="{StaticResource ModernProgressBar}" Height="6" Margin="0,6,0,0" Visibility="Visible"/>
                    </StackPanel>

                    <TextBlock x:Name="HudValueText" Grid.Column="2" Text="65%" Foreground="{DynamicResource AccentTextBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Grid>

            <!-- 3. EXPANDED VIEW -->
            <Grid x:Name="ExpandedView" Width="504" Height="226" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">
                <Grid Margin="16,10,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Navigation Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource TabBarBgBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabMedia" Content="Media" Style="{StaticResource TabBtnStyle}" IsChecked="True" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabSystem" Content="Sistema" Style="{StaticResource TabBtnStyle}" Checked="Tab_Checked" Margin="2,0,0,0"/>
                                <RadioButton x:Name="TabTimer" Content="Timer" Style="{StaticResource TabBtnStyle}" Checked="Tab_Checked" Margin="2,0,0,0"/>
                                <RadioButton x:Name="TabActions" Content="Azioni" Style="{StaticResource TabBtnStyle}" Checked="Tab_Checked" Margin="2,0,0,0"/>
                                <RadioButton x:Name="TabUtility" Content="Utilità" Style="{StaticResource TabBtnStyle}" Checked="Tab_Checked" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="GameModeQuickBtn" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryTextBrush}" Style="{StaticResource PillBtnStyle}" Click="GameModeBtn_Click" ToolTip="Game Mode / Non Disturbare" Margin="0,0,4,0">
                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6,11 L10,11 M8,9 L8,13 M15,12 L15.01,12 M18,10 L18.01,10 M17.32,5 L6.68,5 A4,4 0 0,0 2.74,8.24 L2.06,15.24 A3.5,3.5 0 0,0 5.54,19 A3.5,3.5 0 0,0 8.5,17.2 L9.5,15.5 L14.5,15.5 L15.5,17.2 A3.5,3.5 0 0,0 18.46,19 A3.5,3.5 0 0,0 21.94,15.24 L21.26,8.24 A4,4 0 0,0 17.32,5 Z"/>
                            </Button>
                            <Path x:Name="PinIndicator" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" Data="M16,12 V4 H17 V2 H7 V4 H8 V12 L6,14 V16 H11.2 V22 H12.8 V16 H18 V14 Z"/>
                            <Button x:Name="OpenSettingsBtn" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryTextBrush}" Style="{StaticResource PillBtnStyle}" Click="OpenSettings_Click" ToolTip="Impostazioni" Margin="0,0,6,0">
                                <Path Width="13.5" Height="13.5" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,15 A3,3 0 1,0 12,9 A3,3 0 1,0 12,15 Z M19.4,15 A1.65,1.65 0 0,0 19.73,16.82 L19.79,16.88 A2,2 0 0,1 16.96,19.71 L16.9,19.65 A1.65,1.65 0 0,0 15.08,19.32 A1.65,1.65 0 0,0 14.08,20.83 V21 A2,2 0 0,1 10.08,21 V20.91 A1.65,1.65 0 0,0 9,19.4 A1.65,1.65 0 0,0 7.18,19.73 L7.12,19.79 A2,2 0 0,1 4.29,16.96 L4.35,16.9 A1.65,1.65 0 0,0 4.68,15.08 A1.65,1.65 0 0,0 3.17,14.08 H3 A2,2 0 0,1 3,10.08 H3.09 A1.65,1.65 0 0,0 4.6,9 A1.65,1.65 0 0,0 4.27,7.18 L4.21,7.12 A2,2 0 0,1 7.04,4.29 L7.1,4.35 A1.65,1.65 0 0,0 8.92,4.68 H9 A1.65,1.65 0 0,0 10,3.17 V3 A2,2 0 0,1 14,3 V3.09 A1.65,1.65 0 0,0 15,4.6 A1.65,1.65 0 0,0 16.82,4.27 L16.88,4.21 A2,2 0 0,1 19.71,7.04 L19.65,7.1 A1.65,1.65 0 0,0 19.32,8.92 V9 A1.65,1.65 0 0,0 20.83,10 H21 A2,2 0 0,1 21,14 H20.91 A1.65,1.65 0 0,0 19.4,15 Z"/>
                            </Button>
                            <TextBlock x:Name="ExpandedClockText" Text="00:00" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Tab 0: Media -->
                    <Grid x:Name="MediaPanel" Grid.Row="1" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="64" Height="64" CornerRadius="14" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <TextBlock x:Name="AlbumPlaceholder" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="AlbumArtImage" Stretch="UniformToFill">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,62,62" RadiusX="13" RadiusY="13"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                <Border x:Name="SourceBadge" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,1" HorizontalAlignment="Left" Margin="0,0,0,4" Visibility="Collapsed">
                                    <TextBlock x:Name="SourceAppText" Text="Spotify" Foreground="{DynamicResource AccentTextBrush}" FontSize="9" FontWeight="Bold"/>
                                </Border>
                                <TextBlock x:Name="MediaTitleText" Text="Nessun brano" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MediaArtistText" Text="In attesa di riproduzione" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource CircleMediaBtnStyle}" Click="PrevBtn_Click" Margin="0,0,6,0">
                                    <Path Width="11" Height="11" Stretch="Uniform" Fill="#FFFFFF" Data="M19,20 L9,12 L19,4 Z M5,4 H7 V20 H5 Z"/>
                                </Button>
                                <Button x:Name="PlayPauseBtn" Style="{StaticResource CircleMediaBtnStyle}" Background="#FFFFFF" Foreground="#09090B" Click="PlayPauseBtn_Click" Margin="0,0,6,0">
                                    <Grid>
                                        <Path x:Name="PlayIcon" Width="11" Height="11" Stretch="Uniform" Fill="#09090B" Margin="1.5,0,0,0" Data="M6,4 L20,12 L6,20 Z"/>
                                        <Path x:Name="PauseIcon" Width="10" Height="10" Stretch="Uniform" Fill="#09090B" Visibility="Collapsed" Data="M6,4 H10 V20 H6 Z M14,4 H18 V20 H14 Z"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource CircleMediaBtnStyle}" Click="NextBtn_Click">
                                    <Path Width="11" Height="11" Stretch="Uniform" Fill="#FFFFFF" Data="M5,4 L15,12 L5,20 Z M17,4 H19 V20 H17 Z"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="2,8,2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MediaPosText" Text="0:00" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,0,8,0"/>
                            <ProgressBar x:Name="MediaProgressBar" Grid.Column="1" Style="{StaticResource ModernProgressBar}" Height="5" VerticalAlignment="Center">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#38BDF8" Offset="0"/>
                                        <GradientStop Color="#30D158" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                            <TextBlock x:Name="MediaDurText" Grid.Column="2" Text="0:00" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- System Volume Slider Bar -->
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="VolumeMuteBtn" Width="26" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentTextBrush}" Style="{StaticResource PillBtnStyle}" Click="VolumeMuteBtn_Click" ToolTip="Muta / Smuta">
                                <Grid>
                                    <Path x:Name="VolOnIcon" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M11,5 L6,9 H2 V15 H6 L11,19 Z M15.54,8.46 A5,5 0 0,1 15.54,15.54 M19.07,4.93 A10,10 0 0,1 19.07,19.07"/>
                                    <Path x:Name="VolMuteIcon" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" Data="M11,5 L6,9 H2 V15 H6 L11,19 Z M22,9 L16,15 M16,9 L22,15"/>
                                </Grid>
                            </Button>
                            <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource ModernSlider}" Margin="6,0,8,0" ValueChanged="VolumeSlider_ValueChanged" PreviewMouseLeftButtonDown="VolumeSlider_PreviewMouseDown" PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseUp"/>
                            <TextBlock x:Name="VolumePctText" Grid.Column="2" Text="50%" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- Tab 1: Redesigned Telemetry Cards (CPU, RAM, GPU + Network/Battery) -->
                    <Grid x:Name="SystemPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="3" Margin="0,2,0,8">
                            <!-- CPU Card -->
                            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="13" Padding="11,9" Margin="0,0,5,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="5.5" Height="5.5" Fill="#38BDF8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <Path Width="11" Height="11" Stretch="Uniform" Stroke="#38BDF8" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,4,0" VerticalAlignment="Center" Data="M6,6 H18 V18 H6 Z M9,2 V6 M15,2 V6 M9,18 V22 M15,18 V22 M2,9 H6 M2,15 H6 M18,9 H22 M18,15 H22"/>
                                        <TextBlock Text="CPU" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Margin="0,2,0,3">
                                        <Polyline x:Name="CpuSparkline" Stroke="#5538BDF8" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Width="62" Height="22"/>
                                        <TextBlock x:Name="CpuValueText" Text="0%" FontSize="21" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar x:Name="CpuProgressBar" Grid.Row="2" Style="{StaticResource ModernProgressBar}" Height="5">
                                        <ProgressBar.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#38BDF8" Offset="0"/>
                                                <GradientStop Color="#3B82F6" Offset="1"/>
                                            </LinearGradientBrush>
                                        </ProgressBar.Foreground>
                                    </ProgressBar>
                                </Grid>
                            </Border>

                            <!-- RAM Card -->
                            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="13" Padding="11,9" Margin="3,0,3,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="5.5" Height="5.5" Fill="#C084FC" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <Path Width="11" Height="11" Stretch="Uniform" Stroke="#C084FC" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,4,0" VerticalAlignment="Center" Data="M3,7 H21 V15 H3 Z M6,15 V18 M10,15 V18 M14,15 V18 M18,15 V18 M7,10 V12 M12,10 V12 M17,10 V12"/>
                                            <TextBlock Text="RAM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource ButtonBgBrush}" CornerRadius="5" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="RamSubText" Text="0/0G" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,2,0,3">
                                        <Polyline x:Name="RamSparkline" Stroke="#55C084FC" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Width="62" Height="22"/>
                                        <TextBlock x:Name="RamValueText" Text="0%" FontSize="21" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar x:Name="RamProgressBar" Grid.Row="2" Style="{StaticResource ModernProgressBar}" Height="5">
                                        <ProgressBar.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#A855F7" Offset="0"/>
                                                <GradientStop Color="#EC4899" Offset="1"/>
                                            </LinearGradientBrush>
                                        </ProgressBar.Foreground>
                                    </ProgressBar>
                                </Grid>
                            </Border>

                            <!-- GPU Card -->
                            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="13" Padding="11,9" Margin="5,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="5.5" Height="5.5" Fill="#34D399" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <Path Width="11" Height="11" Stretch="Uniform" Stroke="#34D399" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,4,0" VerticalAlignment="Center" Data="M2,7 H20 A2,2 0 0,1 22,9 V15 A2,2 0 0,1 20,17 H2 Z M6,12 A2,2 0 1,0 10,12 A2,2 0 1,0 6,12 M14,12 A2,2 0 1,0 18,12 A2,2 0 1,0 14,12"/>
                                        <TextBlock Text="GPU" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Margin="0,2,0,3">
                                        <Polyline x:Name="GpuSparkline" Stroke="#5534D399" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Width="62" Height="22"/>
                                        <TextBlock x:Name="GpuValueText" Text="0%" FontSize="21" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar x:Name="GpuProgressBar" Grid.Row="2" Style="{StaticResource ModernProgressBar}" Height="5">
                                        <ProgressBar.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#10B981" Offset="0"/>
                                                <GradientStop Color="#34D399" Offset="1"/>
                                            </LinearGradientBrush>
                                        </ProgressBar.Foreground>
                                    </ProgressBar>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <!-- Network & Power Strip -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="10.5" Height="10.5" Stretch="Uniform" Stroke="#38BDF8" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,5,0" VerticalAlignment="Center" Data="M12,4 V18 M6,13 L12,19 L18,13"/>
                                    <TextBlock x:Name="NetDownText" Text="0.00 MB/s" Foreground="#E2E8F0" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <Path Width="10.5" Height="10.5" Stretch="Uniform" Stroke="#C084FC" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,5,0" VerticalAlignment="Center" Data="M12,20 V6 M6,11 L12,5 L18,11"/>
                                    <TextBlock x:Name="NetUpText" Text="0.00 MB/s" Foreground="#E2E8F0" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="BatteryVectorIcon" Width="11" Height="11" Stretch="Uniform" Stroke="#34D399" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,5,0" VerticalAlignment="Center" Data="M13,2 L4,14 H12 L11,22 L20,10 H12 L13,2 Z"/>
                                    <TextBlock x:Name="BatteryText" Text="AC" Foreground="#34D399" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Tab 2: Timer -->
                    <StackPanel x:Name="TimerPanel" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,10">
                            <TextBlock x:Name="TimerDisplayText" Text="00:00" Foreground="#FFFFFF" FontSize="26" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="1m" Style="{StaticResource PillBtnStyle}" Click="PresetTimer_Click" Tag="1" Margin="0,0,4,0"/>
                                <Button Content="5m" Style="{StaticResource PillBtnStyle}" Click="PresetTimer_Click" Tag="5" Margin="0,0,4,0"/>
                                <Button Content="10m" Style="{StaticResource PillBtnStyle}" Click="PresetTimer_Click" Tag="10" Margin="0,0,4,0"/>
                                <Button Content="15m" Style="{StaticResource PillBtnStyle}" Click="PresetTimer_Click" Tag="15" Margin="0,0,4,0"/>
                                <Button Content="25m" Style="{StaticResource PillBtnStyle}" Click="PresetTimer_Click" Tag="25" ToolTip="Pomodoro"/>
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="TimerProgressBar" Style="{StaticResource ModernProgressBar}" Height="6" Margin="0,0,0,10">
                            <ProgressBar.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                    <GradientStop Color="#EF4444" Offset="1"/>
                                </LinearGradientBrush>
                            </ProgressBar.Foreground>
                        </ProgressBar>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="TimerToggleBtn" Content="Avvia" Style="{StaticResource PillBtnStyle}" Click="TimerToggle_Click" Margin="0,0,6,0"/>
                            <Button x:Name="TimerResetBtn" Content="Reset" Style="{StaticResource PillBtnStyle}" Click="TimerReset_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Tab 4: Quick Actions (6 clean actions) -->
                    <Grid x:Name="ActionsPanel" Grid.Row="1" Visibility="Collapsed">
                        <UniformGrid Columns="3" Rows="2">
                            <Button Style="{StaticResource PillBtnStyle}" Margin="0,0,6,6" Padding="4" Click="MuteBtn_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" Data="M11,5 L6,9 H2 V15 H6 L11,19 Z M22,9 L16,15 M16,9 L22,15"/>
                                    <TextBlock x:Name="ActMuteLabel" Text="Muto" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillBtnStyle}" Margin="3,0,3,6" Padding="4" Click="SnipBtn_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" Data="M6,9 A3,3 0 1,0 6,3 A3,3 0 1,0 6,9 Z M6,21 A3,3 0 1,0 6,15 A3,3 0 1,0 6,21 Z M20,4 L8.12,15.88 M14.47,14.48 L20,20 M8.12,8.12 L12,12"/>
                                    <TextBlock x:Name="ActSnipLabel" Text="Cattura" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillBtnStyle}" Margin="6,0,0,6" Padding="4" Click="LockBtn_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" Data="M5,11 H19 A2,2 0 0,1 21,13 V20 A2,2 0 0,1 19,22 H5 A2,2 0 0,1 3,20 V13 A2,2 0 0,1 5,11 Z M7,11 V7 A5,5 0 0,1 17,7 V11"/>
                                    <TextBlock x:Name="ActLockLabel" Text="Blocca" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillBtnStyle}" Margin="0,6,6,0" Padding="4" Click="AudioOutBtn_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" Data="M3,18 V12 A9,9 0 0,1 21,12 V18 M21,19 A2,2 0 0,1 19,21 H18 A2,2 0 0,1 16,19 V16 A2,2 0 0,1 18,14 H21 Z M3,19 A2,2 0 0,0 5,21 H6 A2,2 0 0,0 8,19 V16 A2,2 0 0,0 6,14 H3 Z"/>
                                    <TextBlock x:Name="ActAudioOutLabel" Text="Audio" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillBtnStyle}" Margin="3,6,3,0" Padding="4" Click="ColorPickerBtn_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" Data="M12,2 A10,10 0 0,0 2,12 A10,10 0 0,0 12,22 C13.5,22 14,21 14,19.8 C14,19.2 13.8,18.7 13.5,18.3 C13.1,17.9 13,17.4 13,16.8 A2,2 0 0,1 15,14.8 H17 A5,5 0 0,0 22,9.8 C22,5.3 17.5,2 12,2 Z"/>
                                    <TextBlock x:Name="ActPickerLabel" Text="Colore" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillBtnStyle}" Margin="6,6,0,0" Padding="4" Click="OpenSettings_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" Data="M12,15 A3,3 0 1,0 12,9 A3,3 0 1,0 12,15 Z M19.4,15 A1.65,1.65 0 0,0 19.73,16.82 L19.79,16.88 A2,2 0 0,1 16.96,19.71 L16.9,19.65 A1.65,1.65 0 0,0 15.08,19.32 A1.65,1.65 0 0,0 14.08,20.83 V21 A2,2 0 0,1 10.08,21 V20.91 A1.65,1.65 0 0,0 9,19.4 A1.65,1.65 0 0,0 7.18,19.73 L7.12,19.79 A2,2 0 0,1 4.29,16.96 L4.35,16.9 A1.65,1.65 0 0,0 4.68,15.08 A1.65,1.65 0 0,0 3.17,14.08 H3 A2,2 0 0,1 3,10.08 H3.09 A1.65,1.65 0 0,0 4.6,9 A1.65,1.65 0 0,0 4.27,7.18 L4.21,7.12 A2,2 0 0,1 7.04,4.29 L7.1,4.35 A1.65,1.65 0 0,0 8.92,4.68 H9 A1.65,1.65 0 0,0 10,3.17 V3 A2,2 0 0,1 14,3 V3.09 A1.65,1.65 0 0,0 15,4.6 A1.65,1.65 0 0,0 16.82,4.27 L16.88,4.21 A2,2 0 0,1 19.71,7.04 L19.65,7.1 A1.65,1.65 0 0,0 19.32,8.92 V9 A1.65,1.65 0 0,0 20.83,10 H21 A2,2 0 0,1 21,14 H20.91 A1.65,1.65 0 0,0 19.4,15 Z"/>
                                    <TextBlock x:Name="ActOptionsLabel" Text="Opzioni" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>

                    <!-- Tab 5: Utility (50% Clipboard History + 50% Keyboard Calculator) -->
                    <Grid x:Name="UtilityPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Half: Recent Clips -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="RecentClipsTitle" Text="APPUNTI RECENTI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="ClickToCopyLabel" Text="Clicca per copiare" FontSize="9.5" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Button x:Name="ClearClipsBtn" Style="{StaticResource PillBtnStyle}" Padding="5,3" Click="ClearClipsBtn_Click" ToolTip="Pulisci">
                                            <Path Width="11" Height="11" Stretch="Uniform" Stroke="#CBD5E1" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,6 H21 M19,6 V20 A2,2 0 0,1 17,22 H7 A2,2 0 0,1 5,20 V6 M8,6 V4 A2,2 0 0,1 10,2 H14 A2,2 0 0,1 16,4 V6"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                    <TextBlock x:Name="EmptyClipLabel" Text="Nessun appunto" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Padding="4,6" Visibility="Visible"/>
                                    <Button x:Name="ClipBtn0" Style="{StaticResource PillBtnStyle}" HorizontalContentAlignment="Left" Padding="8,5" Margin="0,0,0,4" Click="ClipHistory_Click" Tag="0" Visibility="Collapsed">
                                        <TextBlock x:Name="ClipText0" Text="" TextTrimming="CharacterEllipsis" FontSize="11.5" Foreground="#FFFFFF"/>
                                    </Button>
                                    <Button x:Name="ClipBtn1" Style="{StaticResource PillBtnStyle}" HorizontalContentAlignment="Left" Padding="8,5" Margin="0,0,0,4" Click="ClipHistory_Click" Tag="1" Visibility="Collapsed">
                                        <TextBlock x:Name="ClipText1" Text="" TextTrimming="CharacterEllipsis" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Button>
                                    <Button x:Name="ClipBtn2" Style="{StaticResource PillBtnStyle}" HorizontalContentAlignment="Left" Padding="8,5" Click="ClipHistory_Click" Tag="2" Visibility="Collapsed">
                                        <TextBlock x:Name="ClipText2" Text="" TextTrimming="CharacterEllipsis" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Right Half: Keyboard Calculator -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="11,8">
                                <Grid>
                                    <TextBlock x:Name="CalcPlaceholder" Text="Scrivi" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBox x:Name="CalcInputBox" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#38BDF8" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Padding="0" TextChanged="CalcInputBox_TextChanged" PreviewKeyDown="CalcInputBox_PreviewKeyDown" GotFocus="CalcInputBox_GotFocus"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="11,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="CalcExprText" Text="=" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="CalcDisplayText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="CalcCopyBtn" Content="Copia" Style="{StaticResource PillBtnStyle}" Padding="9,6" FontSize="11" FontWeight="SemiBold" Margin="0,0,5,0" Click="CalcCopy_Click"/>
                                        <Button Content="C" Style="{StaticResource PillBtnStyle}" Padding="9,6" FontSize="11" FontWeight="Bold" Foreground="#FCA5A5" Click="CalcClear_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
