<Window x:Class="HyperNotch.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="False"
        SnapsToDevicePixels="False"
        FontFamily="pack://application:,,,/Assets/Fonts/#Inter, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        RenderOptions.BitmapScalingMode="Fant"
        RenderOptions.EdgeMode="Unspecified"
        SizeToContent="WidthAndHeight">
    <Window.Resources>
        <Style x:Key="MenuItemBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExitItemBtn" TargetType="Button" BasedOn="{StaticResource MenuItemBtn}">
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24EF4444"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#40EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38EF4444"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#55EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12" Width="244">
        <!-- Outer ambient shadow + modern gradient border -->
        <Border CornerRadius="18" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F70B0E17" Offset="0.0"/>
                    <GradientStop Color="#F7101624" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#5538BDF8" Offset="0.0"/>
                    <GradientStop Color="#22FFFFFF" Offset="0.45"/>
                    <GradientStop Color="#446366F1" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.65" Color="#000000"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="18" Padding="9" ClipToBounds="True">
            <StackPanel>
                <!-- Header Card -->
                <Border CornerRadius="12" Padding="10,8" Margin="0,0,0,7" BorderThickness="1" BorderBrush="#1AFFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1F38BDF8" Offset="0.0"/>
                            <GradientStop Color="#126366F1" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Mini HyperNotch Pill Mark -->
                            <Border Width="22" Height="12" CornerRadius="6" Background="#050507" BorderBrush="#38BDF8" BorderThickness="1.3" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Width="4.5" Height="4.5" Fill="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2.5,0"/>
                            </Border>
                            <TextBlock Text="HyperNotch" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Background="#2238BDF8" BorderBrush="#4D38BDF8" BorderThickness="1" CornerRadius="7" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="240 FPS" Foreground="#7DD3FC" FontSize="9.5" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Menu Actions -->
                <Button Style="{StaticResource MenuItemBtn}" Click="Toggle_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8" Background="#1E38BDF8" Margin="0,0,10,0">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="#38BDF8" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M1,12 C1,12 5,4 12,4 C19,4 23,12 23,12 C23,12 19,20 12,20 C5,20 1,12 1,12 Z M12,15 A3,3 0 1,0 12,9 A3,3 0 1,0 12,15 Z"/>
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="ToggleText" Text="Mostra / Nascondi" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="›" Foreground="#64748B" FontSize="14" VerticalAlignment="Center" Margin="6,0,2,1"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource MenuItemBtn}" Click="GameMode_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8" Background="#1EA855F7" Margin="0,0,10,0">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="#C084FC" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M6,11 L10,11 M8,9 L8,13 M15,12 L15.01,12 M18,10 L18.01,10 M17.32,5 L6.68,5 A4,4 0 0,0 2.74,8.24 L2.06,15.24 A3.5,3.5 0 0,0 5.54,19 A3.5,3.5 0 0,0 8.5,17.2 L9.5,15.5 L14.5,15.5 L15.5,17.2 A3.5,3.5 0 0,0 18.46,19 A3.5,3.5 0 0,0 21.94,15.24 L21.26,8.24 A4,4 0 0,0 17.32,5 Z"/>
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="GameModeText" Text="Game Mode (On/Off)" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="›" Foreground="#64748B" FontSize="14" VerticalAlignment="Center" Margin="6,0,2,1"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource MenuItemBtn}" Click="Settings_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8" Background="#2294A3B8" Margin="0,0,10,0">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="#CBD5E1" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M12,15 A3,3 0 1,0 12,9 A3,3 0 1,0 12,15 Z M19.4,15 A1.65,1.65 0 0,0 19.73,16.82 L19.79,16.88 A2,2 0 0,1 16.96,19.71 L16.9,19.65 A1.65,1.65 0 0,0 15.08,19.32 A1.65,1.65 0 0,0 14.08,20.83 V21 A2,2 0 0,1 10.08,21 V20.91 A1.65,1.65 0 0,0 9,19.4 A1.65,1.65 0 0,0 7.18,19.73 L7.12,19.79 A2,2 0 0,1 4.29,16.96 L4.35,16.9 A1.65,1.65 0 0,0 4.68,15.08 A1.65,1.65 0 0,0 3.17,14.08 H3 A2,2 0 0,1 3,10.08 H3.09 A1.65,1.65 0 0,0 4.6,9 A1.65,1.65 0 0,0 4.27,7.18 L4.21,7.12 A2,2 0 0,1 7.04,4.29 L7.1,4.35 A1.65,1.65 0 0,0 8.92,4.68 H9 A1.65,1.65 0 0,0 10,3.17 V3 A2,2 0 0,1 14,3 V3.09 A1.65,1.65 0 0,0 15,4.6 A1.65,1.65 0 0,0 16.82,4.27 L16.88,4.21 A2,2 0 0,1 19.71,7.04 L19.65,7.1 A1.65,1.65 0 0,0 19.32,8.92 V9 A1.65,1.65 0 0,0 20.83,10 H21 A2,2 0 0,1 21,14 H20.91 A1.65,1.65 0 0,0 19.4,15 Z"/>
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="SettingsText" Text="Impostazioni" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="›" Foreground="#64748B" FontSize="14" VerticalAlignment="Center" Margin="6,0,2,1"/>
                    </Grid>
                </Button>

                <Border Height="1" Background="#16FFFFFF" Margin="4,6,4,6"/>

                <Button Style="{StaticResource ExitItemBtn}" Click="Exit_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8" Background="#20EF4444" Margin="0,0,10,0">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="#F87171" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M18.36,6.64 A9,9 0 1,1 5.64,6.64 M12,2 V12"/>
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="ExitText" Text="Esci" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
